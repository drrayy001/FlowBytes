<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sleek vertical gradient for a dynamic background depth -->
    <gradient
        android:startColor="#F21E232B"
        android:endColor="#F2101317"
        android:angle="270" />
    <!-- Fine 1dp subtle border with 13% white opacity for a glass look -->
    <stroke
        android:width="1dp"
        android:color="#22FFFFFF" />
    <!-- Corner radius compliant with modern launcher widgets -->
    <corners android:radius="28dp" />
</shape>
