+import com.ray.flowmeter.R
+import java.time.DayOfWeek
+import java.time.format.TextStyle
+import java.util.Locale
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+fun AppBlockRulesSection(
+    alwaysBlocked: Boolean,
+    onAlwaysBlockedChange: (Boolean) -> Unit,
+    scheduleEnabled: Boolean,
+    onScheduleEnabledChange: (Boolean) -> Unit,
+    scheduleDays: Int,
+    onScheduleDaysChange: (Int) -> Unit,
+    startMin: Int,
+    onStartChange: (Int) -> Unit,
+    endMin: Int,
+    onEndChange: (Int) -> Unit,
+) {
+    var pickingStart by remember { mutableStateOf(false) }
+    var pickingEnd by remember { mutableStateOf(false) }
+
+    Column(modifier = Modifier.fillMaxWidth().padding(top = 24.dp)) {
+        Text(
+            text = stringResource(R.string.block_rules_title),
+            style = MaterialTheme.typography.titleMedium,
+            fontWeight = FontWeight.Bold,
+        )
+        Spacer(Modifier.height(8.dp))
+
+        RuleSwitchRow(
+            title = stringResource(R.string.block_always_title),
+            description = stringResource(R.string.block_always_desc),
+            checked = alwaysBlocked,
+            onCheckedChange = onAlwaysBlockedChange,
+        )
+
+        RuleSwitchRow(
+            title = stringResource(R.string.block_schedule_title),
+            description = stringResource(R.string.block_schedule_desc),
+            checked = scheduleEnabled,
+            onCheckedChange = onScheduleEnabledChange,
+        )
+
+        if (scheduleEnabled) {
+            Spacer(Modifier.height(8.dp))
+            // Bit 0 = Monday ... bit 6 = Sunday.
+            FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                for (day in 0..6) {
+                    val selected = ((scheduleDays shr day) and 1) == 1
+                    FilterChip(
+                        selected = selected,
+                        onClick = { onScheduleDaysChange(scheduleDays xor (1 shl day)) },
+                        label = {
+                            Text(DayOfWeek.of(day + 1).getDisplayName(TextStyle.SHORT, Locale.getDefault()))
+                        },
+                    )
+                }
+            }
+            Spacer(Modifier.height(8.dp))
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedButton(onClick = { pickingStart = true }) {
+                    Text(stringResource(R.string.block_schedule_from, formatMinutes(startMin)))
+                }
+                OutlinedButton(onClick = { pickingEnd = true }) {
+                    Text(stringResource(R.string.block_schedule_to, formatMinutes(endMin)))
+                }
+            }
+            Spacer(Modifier.height(8.dp))
+            Text(
+                text = stringResource(R.string.block_schedule_note),
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+    }
+
+    if (pickingStart) {
+        TimeDialog(
+            initialMinutes = startMin,
+            onDismiss = { pickingStart = false },
+            onConfirm = {
+                onStartChange(it)
+                pickingStart = false
+            },
+        )
+    }
+    if (pickingEnd) {
+        TimeDialog(
+            initialMinutes = endMin,
+            onDismiss = { pickingEnd = false },
+            onConfirm = {
+                onEndChange(it)
+                pickingEnd = false
+            },
+        )
+    }
+}
+
+@Composable
+private fun RuleSwitchRow(
+    title: String,
+    description: String,
+    checked: Boolean,
+    onCheckedChange: (Boolean) -> Unit,
+) {
+    Row(
+        modifier = Modifier.fillMaxWidth().padding(vertical = 6.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Column(modifier = Modifier.weight(1f)) {
+            Text(title, style = MaterialTheme.typography.bodyLarge, fontWeight = FontWeight.SemiBold)
+            Text(
+                description,
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+            )
+        }
+        Spacer(Modifier.width(12.dp))
+        Switch(checked = checked, onCheckedChange = onCheckedChange)
+    }
+}
+
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun TimeDialog(
+    initialMinutes: Int,
+    onDismiss: () -> Unit,
+    onConfirm: (Int) -> Unit,
+) {
+    val is24Hour = DateFormat.is24HourFormat(LocalContext.current)
+    val state = rememberTimePickerState(
+        initialHour = initialMinutes / 60,
+        initialMinute = initialMinutes % 60,
+        is24Hour = is24Hour,
+    )
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        confirmButton = {
+            TextButton(onClick = { onConfirm(state.hour * 60 + state.minute) }) {
+                Text(stringResource(android.R.string.ok))
+            }
+        },
+        dismissButton = {
+            TextButton(onClick = onDismiss) {
+                Text(stringResource(android.R.string.cancel))
+            }
+        },
+        text = { TimePicker(state = state) },
+    )
+}
+
+private fun formatMinutes(minutes: Int): String =
+    String.format(Locale.getDefault(), "%02d:%02d", minutes / 60, minutes % 60)
