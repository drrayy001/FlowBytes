<resources>

    <style name="Theme.FlowMeter" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Dark Mode Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background matches FlowBytes BackgroundDark (#1A1B1E) -->
        <item name="windowSplashScreenBackground">#1A1B1E</item>
        <!-- FlowBytes custom vector brand icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Post splash theme -->
        <item name="postSplashScreenTheme">@style/Theme.FlowMeter</item>
    </style>
</resources>
