<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent dark background for a glass-morphism effect -->
    <solid android:color="#E6121212" />
    <!-- Subtle border to help visibility on complex wallpapers -->
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <!-- Large corner radius for a modern look -->
    <corners android:radius="28dp" />
</shape>
